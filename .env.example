# Copy this to .env and fill in values before running.

# OpenAI key for LangChain LLM
OPENAI_API_KEY=sk-...

# Wi-Fi hotspot (used by ESP32 — document here for reference)
HOTSPOT_SSID=YourHotspotName
HOTSPOT_PASSWORD=YourHotspotPassword

# MQTT broker credentials (must match Mosquitto pwfile)
MQTT_BROKER_IP=<YOUR_BROKER_IP>
MQTT_BROKER_PORT=1883
MQTT_USERNAME=refinery_node
MQTT_PASSWORD=<YOUR_MQTT_PASSWORD>

# Yellow pump flow rate — fill after 10-second graduated-cup calibration
YELLOW_FLOW_RATE_ML_PER_SEC=8.8

# Power constraint for governor (mA). Default 300 per spec.
POWER_CONSTRAINT_MA=300

# Run without hardware (generates synthetic telemetry)
MOCK_MODE=false
